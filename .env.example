# Docker 部署配置（复制为 .env）
ARTEX_TAG=latest
POSTGRES_USER=artex
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=artex

# 私有 GitHub Release 更新（仅后端读取；令牌需 Hinln/ARTEX 的 Contents: read）
ARTEX_UPDATE_GITHUB_TOKEN=

# LLM（二选一或都填；也可留空到 UI 里配）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ARTEX_LLM_PROVIDER=
ARTEX_LLM_MODEL=
ARTEX_LLM_BASE_URL=
ARTEX_LLM_PROXY=

# HTTPS 反向代理：填写实际代理源地址/CIDR，勿填写 0.0.0.0/0。
ARTEX_TRUSTED_PROXIES=
# 额外可信前端来源（逗号分隔，完整 scheme://host:port，无尾部 /）。
ARTEX_ALLOWED_ORIGINS=
# HTTPS 部署设为 1；本地 HTTP 开发保持 0。
ARTEX_COOKIE_SECURE=0
ARTEX_PIDS_LIMIT=512
ARTEX_MEMORY_LIMIT=4g
ARTEX_CPU_LIMIT=2
